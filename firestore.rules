rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Used for message subcollection reads — get()s the parent chat doc.
    // NOT used for the chat doc itself (would be self-referential).
    function isChatMember(chatId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groupChats/$(chatId)).data.memberIds;
    }

    // Invite IDs are stored as "{chatId}_{invitedUid}" so we can check
    // existence without a collection query (exists() is cheaper than get()).
    function hasPendingInvite(chatId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groupChatInvites/$(chatId + "_" + request.auth.uid));
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read:   if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /presence/{userId} {
      allow read:  if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /issues/{issueId} {
      allow read:   if true;
      allow create: if request.auth != null &&
                    request.resource.data.title is string &&
                    request.resource.data.title.size() <= 200 &&
                    request.resource.data.description is string &&
                    request.resource.data.description.size() <= 5000;
      // Clients may update their own posts but NEVER touch vote aggregates —
      // those are written exclusively by /api/vote (Admin SDK bypasses rules).
      allow update: if request.auth != null && (
                      isAdmin() ||
                      (request.auth.uid == resource.data.author.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['upvotes', 'downvotes', 'votes', 'totalVotes']))
                    );
      allow delete: if isAdmin();

      match /votes/{voteId} {
        allow read: if true;
        // All vote writes go through /api/vote (Admin SDK) — block direct client writes
        allow write: if false;
      }

      match /comments/{commentId} {
        allow read:   if true;
        allow create: if request.auth != null;
        allow update: if request.auth != null && (
                        request.auth.uid == resource.data.userId ||
                        isAdmin() ||
                        // Any signed-in user may like/unlike — only 'likes' field changes
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                      );
        allow delete: if request.auth != null
                      && (request.auth.uid == resource.data.userId || isAdmin());
      }
    }

    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /badges/{badgeId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /savedIssues/{savedId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /stats/{statId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /referrals/{ownerId} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == ownerId;

      match /referrals/{referralId} {
        allow read:           if request.auth != null && request.auth.uid == ownerId;
        allow create:         if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == ownerId;
      }

      match /stats/{statId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == ownerId;
      }
    }

    match /reports/{reportId} {
      allow read:   if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Chat doc: use resource.data.memberIds directly (not get()) to avoid
    // a self-referential read that Firestore rejects.
    match /groupChats/{chatId} {
      allow read:   if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
                      // Any member may update lastMessage preview fields only
                      (request.auth.uid in resource.data.memberIds &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt'])) ||
                      // Group admins (or creator for legacy groups) can change anything
                      (request.auth.uid in resource.data.get('adminIds', [resource.data.createdBy])) ||
                      // Non-member self-join via accepted invite
                      (request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
                       request.auth.uid in request.resource.data.memberIds &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['memberIds', 'members', 'updatedAt']))
                    );
      allow delete: if false;

      match /messages/{messageId} {
        allow read:   if isChatMember(chatId);
        allow create: if isChatMember(chatId);
        allow update, delete: if isChatMember(chatId)
                              && request.auth.uid == resource.data.senderId;
      }
    }

    // Invites use fixed IDs: "{chatId}_{invitedUid}"
    // Only existing chat members can create invites for their group.
    match /groupChatInvites/{inviteId} {
      allow read:   if isSignedIn() && (
                      request.auth.uid == resource.data.invitedUid ||
                      request.auth.uid == resource.data.invitedByUid
                    );
      allow create: if isChatMember(request.resource.data.chatId);
      allow update: if isSignedIn() && (
                      request.auth.uid == resource.data.invitedUid ||
                      request.auth.uid == resource.data.invitedByUid
                    );
      allow delete: if false;
    }
  }
}
